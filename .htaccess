    RewriteEngine On

    # Defense in depth for misconfigured hosts. Production document root must
    # still point to /public; these rules only reduce blast radius if it does not.
    RewriteRule (^|/)(\.env|\.git)(/|$) - [F,L]
    RewriteRule ^(storage|vendor|database|bootstrap/cache)(/|$) - [F,L]
    RewriteRule ^(composer\.(json|lock)|package(-lock)?\.json|bun\.lockb?|pnpm-lock\.yaml|yarn\.lock)$ - [F,L]
    RewriteRule \.(sql|zip|tar|gz|tgz|bak|old)$ - [F,L]

    RewriteRule ^(.*)$ public/$1 [L]
