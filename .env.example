APP_NAME="PasPapan"

# Application Environment Modes:
# 1. local: Local install defaults. APP_ENV=local, APP_DEBUG=true.
# 2. production: Live system. APP_ENV=production, APP_DEBUG=false.
APP_ENV=local
APP_DEBUG=true
AUTH_DEBUG_LOG=false

APP_KEY=
# Optional runtime license seed. Leave blank for open source/community installs.
# Enterprise customers can paste the license in Admin > Settings > Enterprise instead.
ENTERPRISE_LICENSE_KEY=
ENTERPRISE_LICENSE_PRIVATE_KEY_PATH=
TEST_ENTERPRISE_LICENSE_PRIVATE_KEY_PATH=
VERCEL_MAINTENANCE_ENDPOINT_ENABLED=false
VERCEL_MAINTENANCE_TOKEN=
VERCEL_ALLOW_WEB_SEED=false
PASPAPAN_RELEASE_BRANCH=main-vps
PASPAPAN_UPDATE_MAINTENANCE_MODE=0
PASPAPAN_UPDATE_VIEW_CACHE=0

# APP_TIMEZONE=UTC
APP_TIMEZONE=Asia/Jakarta

APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Local and production target VPS use PostgreSQL by default.
# Compatibility options for managed DB providers: mysql or mariadb.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=absensi
DB_USERNAME=postgres
DB_PASSWORD=
DB_SCHEMA=public
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_COOKIE=paspapan_session
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
# Production HTTPS deployments should set SESSION_SECURE_COOKIE=true.
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
DEMO_SEEDING_ENABLED=false
BOOTSTRAP_ADMIN_SEEDING_ENABLED=false

BROADCAST_CONNECTION=log
ANNOUNCEMENT_REFRESH_MODE=auto
ANNOUNCEMENT_POLL_INTERVAL=60s
COLLABORATION_REALTIME_ENABLED=false
COLLABORATION_REALTIME_POLL_INTERVAL=30s
FILESYSTEM_DISK=local
FILESYSTEM_ATTACHMENT_DISKS=local
# Legacy only after explicit migration review:
# FILESYSTEM_ATTACHMENT_DISKS=local,public
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=
LIVEWIRE_TEMPORARY_FILE_UPLOAD_RULES=file|max:12288
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DIRECTORY=livewire-tmp
LIVEWIRE_TEMPORARY_FILE_UPLOAD_MIDDLEWARE=throttle:60,1
QUEUE_CONNECTION=database
SCHEDULE_QUEUE_WORKER=true

# Generic inbound attendance integration API.
# Sign POST /api/integrations/attendance-events with:
# X-PasPapan-Api-Key=<integration api key>
# X-PasPapan-Timestamp=<unix timestamp>
# X-PasPapan-Signature=sha256=<hmac_sha256(timestamp + "." + raw_json_body, secret)>
ATTENDANCE_INTEGRATION_API_KEY=
ATTENDANCE_INTEGRATION_SECRET=
ATTENDANCE_INTEGRATION_SIGNATURE_TOLERANCE_SECONDS=300
ATTENDANCE_INTEGRATION_ALLOWED_SOURCES=

CACHE_STORE=database
CACHE_PREFIX=paspapan_cache_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_PREFIX=paspapan_database_
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=b2fddd001@smtp-brevo.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@paspapan.pandanteknik.com"
MAIL_FROM_NAME="PasPapan HRIS"

# Telegram Engagement - Tolerant for sluggish connectivity (daily reminders channel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_DEFAULT_PARSE_MODE=MarkdownV2
TELEGRAM_HTTP_TIMEOUT=20
TELEGRAM_RETRY_COUNT=3
TELEGRAM_RETRY_SLEEP_MS=400

# Backup VPN (filament-shielded) logger via Telegram for high-frequency health events
TELEGRAM_BACKUP_HEALTHCHAT_ONLY_BOT_TOKEN=
TELEGRAM_BACKUP_HEALTHCHAT_ONLY_CHAT_ID=

# AWS (opsional, tidak dipakai di mailer).
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Enterprise runtime secrets
# Community / open-source install should stay empty.
# Enterprise artifacts require a 32+ char value at runtime.
ENTERPRISE_OBFUSCATOR_KEY=
# Toko/POS enterprise add-on requires this extra 32+ char salt in addition to ENTERPRISE_OBFUSCATOR_KEY.
ENTERPRISE_ADDON_SALT_TOKO_POS=

VITE_APP_NAME="${APP_NAME}"

# VPS realtime mode:
# Local Reverb smoke can use 127.0.0.1:8080 with `php artisan reverb:start`.
# Production should use the public HTTPS host/proxy for REVERB_HOST/PORT/SCHEME.
# BROADCAST_CONNECTION=reverb
# ANNOUNCEMENT_REFRESH_MODE=auto
# COLLABORATION_REALTIME_ENABLED=true
# REVERB_APP_ID=local-paspapan
# REVERB_APP_KEY=change-me
# REVERB_APP_SECRET=change-me-secret
# REVERB_HOST=127.0.0.1
# REVERB_PORT=8080
# REVERB_SCHEME=http
# REVERB_SERVER_HOST=0.0.0.0
# REVERB_SERVER_PORT=8080
REDIS_CLIENT=predis
